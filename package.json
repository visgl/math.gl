{
  "name": "math.gl-monorepo",
  "description": "Array-based 3D Math Classes optimized for WebGL applications",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "workspaces": [
    "dev-modules/*",
    "modules/*",
    "examples/*/*",
    "website"
  ],
  "scripts": {
    "bootstrap": "yarn && ocular-bootstrap && yarn build",
    "build": "ocular-clean && time ocular-build",
    "check:spatial-index-package": "node modules/geometry/scripts/spatial-index/check-package.mjs",
    "check:source-headers": "node scripts/check-source-headers.mjs",
    "check:curves-package": "node modules/geometry/scripts/curves/check-package.mjs",
    "check:crs-types": "npx tsc --project test/types/crs/tsconfig.json",
    "check:arrow-expression-types": "tsc --project test/types/arrow-expressions/tsconfig.json",
    "check:sql-types": "tsc --project test/types/sql/tsconfig.json",
    "check:task-runner-types": "tsc --project test/types/task-runner/tsconfig.json",
    "check:geoarrow-boundary": "node modules/arrow/scripts/geoarrow/check-package-boundary.mjs",
    "check:timezone-types": "npx tsc --project test/types/timezone/tsconfig.json",
    "check:timezone-boundary": "node modules/earth/scripts/timezone/check-package-boundary.mjs",
    "check:wkb-boundary": "node modules/arrow/scripts/wkb/check-package-boundary.mjs",
    "check:projjson-types": "node scripts/generate-projjson-types.mjs --check",
    "generate:projjson-types": "node scripts/generate-projjson-types.mjs",
    "cover": "yarn test-coverage",
    "lint": "ocular-lint",
    "metrics": "ocular-metrics",
    "playwright:install": "playwright install chromium",
    "publish-beta": "node scripts/publish-beta.mjs",
    "publish-prod": "ocular-publish version-only-prod",
    "test": "ocular-test node headless",
    "test-browser": "ocular-test browser",
    "test-headless": "ocular-test headless",
    "test-node": "ocular-test node",
    "test-coverage": "ocular-test headless --coverage",
    "test-pre-commit": "yarn lint && ocular-test node",
    "check:timezone-geometry": "python3 modules/earth/scripts/timezone/check-geometry.py",
    "check:parametric-package": "node modules/geometry/scripts/check-parametric-package.mjs",
    "check:c8-package": "node modules/geospatial/scripts/check-c8-package.mjs",
    "benchmark:g7": "node modules/geospatial/scripts/benchmark-g7.mjs",
    "check:geographic-seams-package": "node modules/geospatial/scripts/check-geographic-seams-package.mjs",
    "check:geodesic-path-package": "node modules/geospatial/scripts/check-geodesic-path-package.mjs",
    "check:tile-matrix-package": "node modules/geospatial/scripts/check-tile-matrix-package.mjs",
    "check:tree-shaking": "node scripts/check-tree-shaking.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "check:attributions": "node scripts/check-attributions.mjs",
    "check:terrain-dem": "node scripts/qualify-terrain-dem.mjs",
    "benchmark:arrow-expressions": "node test/bench/arrow-sql-expressions.mjs",
    "benchmark:workers": "node test/bench/workers/index.mjs",
    "check:tasks": "node modules/tasks/scripts/check-tasks.mjs",
    "citations:generate": "node scripts/citations/check.mjs --write",
    "check:citations": "node scripts/citations/check.mjs && node --test scripts/citations/*.test.mjs",
    "check:arrow": "node modules/arrow/scripts/check-arrow.mjs",
    "check:geoarrow-api": "node modules/arrow/scripts/geoarrow/check-arrow-api.mjs",
    "test-examples:node": "node test/examples/run.js node",
    "test-examples:browser": "node test/examples/run.js browser",
    "benchmark:browser": "MATHGL_BROWSER_BENCHMARKS=1 ocular-test headless",
    "test-examples": "node test/examples/run.js all"
  },
  "devDependencies": {
    "@citation-js/core": "^0.9.0",
    "@citation-js/plugin-bibtex": "^0.9.0",
    "@deck.gl/core": "^9.4.1",
    "@math.gl/expressions": "5.0.0-beta.8",
    "@turf/destination": "^7.4.0",
    "@types/node": "^22.20.1",
    "@vis.gl/dev-tools": "^2.0.0-beta.2",
    "@vis.gl/ts-plugins": "^2.0.0-beta.2",
    "@vitest/coverage-v8": "5.0.5",
    "a5-js": "^0.10.0",
    "ajv": "^8.20.0",
    "apache-arrow": "17.0.0",
    "apache-arrow-18": "npm:apache-arrow@^18.0.0",
    "apache-arrow-19": "npm:apache-arrow@^19.0.0",
    "apache-arrow-20": "npm:apache-arrow@^20.0.0",
    "apache-arrow-current": "npm:apache-arrow@21.2.0",
    "esbuild": "^0.28.1",
    "geotiff": "3.0.5",
    "h3-js": "^4.5.0",
    "json-schema-to-typescript": "^16.0.0",
    "lerna": "10.1.2",
    "math.gl-parquet-loader": "workspace:*",
    "playwright": "^1.62.1",
    "pngjs": "^7.0.0",
    "pre-commit": "^2.0.0",
    "probe.gl": "^5.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vite": "^8.3.6",
    "vitest": "5.0.5"
  },
  "pre-commit": [
    "test-pre-commit"
  ],
  "packageManager": "yarn@4.18.0+sha512.fcb8716fe7cd0eece141ffc18b92193a9df9204c1ba83189c288835223fc0bbe64af473bab0d5e9927a7daeb5caf2bb07eb2787cc9338ca040ea125f2a1f2f7e",
  "resolutions": {
    "@loaders.gl/textures@npm:4.4.5": "npm:4.5.4",
    "@loaders.gl/textures@npm:4.5.2": "npm:4.5.4",
    "@loaders.gl/textures@npm:~4.4.5": "npm:4.5.4",
    "fflate@npm:0.7.4": "npm:0.7.5",
    "glob@npm:^13.0.0": "npm:14.0.2",
    "glob@npm:^13.0.6": "npm:14.0.2",
    "minimatch@npm:10.2.5": "npm:11.0.1",
    "minimatch@npm:^10.0.3": "npm:11.0.1",
    "minimatch@npm:^10.2.2": "npm:11.0.1",
    "minimatch@npm:^10.2.6": "npm:11.0.1",
    "serialize-javascript@npm:^6.0.0": "npm:7.1.3",
    "serialize-javascript@npm:^6.0.1": "npm:7.1.3",
    "tinypool@npm:^1.0.2": "npm:2.1.2",
    "uuid@npm:^8.3.2": "npm:11.1.1",
    "undici@npm:7.29.0": "npm:7.30.2",
    "sigstore@npm:^5.0.0": "patch:sigstore@npm%3A5.0.0#./.yarn/patches/sigstore-npm-5.0.0-conflict-recovery.patch"
  }
}
