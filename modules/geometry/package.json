{
  "name": "@math.gl/geometry",
  "description": "CPU geometry primitives and tessellation for math.gl",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0",
  "keywords": [
    "geometry",
    "gltf",
    "math",
    "mesh",
    "tessellation",
    "3d"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "exports": {
    "./culling": {
      "types": "./dist/culling/index.d.ts",
      "import": "./dist/culling/index.js",
      "require": "./dist/culling/index.cjs"
    },
    "./processing": {
      "types": "./dist/processing.d.ts",
      "import": "./dist/processing.js",
      "require": "./dist/processing.cjs"
    },
    "./spatial-index": {
      "types": "./dist/spatial-index/index.d.ts",
      "import": "./dist/spatial-index/index.js",
      "require": "./dist/spatial-index/index.cjs"
    },
    "./lighting": {
      "types": "./dist/lighting/index.d.ts",
      "import": "./dist/lighting/index.js",
      "require": "./dist/lighting/index.cjs"
    },
    "./arrow": {
      "types": "./dist/arrow/index.d.ts",
      "import": "./dist/arrow/index.js",
      "require": "./dist/arrow/index.cjs"
    },
    "./primitives": {
      "types": "./dist/primitives.d.ts",
      "import": "./dist/primitives.js",
      "require": "./dist/primitives.cjs"
    },
    "./curves": {
      "types": "./dist/curves/index.d.ts",
      "import": "./dist/curves/index.js",
      "require": "./dist/curves/index.cjs"
    },
    "./polygon": {
      "types": "./dist/polygon/index.d.ts",
      "import": "./dist/polygon/index.js",
      "require": "./dist/polygon/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/README.md",
    "./README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "@math.gl/core": "5.0.0"
  },
  "sideEffects": false,
  "peerDependencies": {
    "apache-arrow": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "apache-arrow": {
      "optional": true
    }
  }
}
