{
  "name": "@math.gl/geometry",
  "description": "CPU geometry primitives and tessellation for math.gl",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.19",
  "keywords": [
    "geometry",
    "gltf",
    "math",
    "mesh",
    "tessellation",
    "3d"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./parametric": {
      "types": "./dist/parametric.d.ts",
      "import": "./dist/parametric.js",
      "require": "./dist/parametric.cjs"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "import": "./dist/utils/index.js",
      "require": "./dist/utils/index.cjs"
    },
    "./curves": {
      "types": "./dist/curves/index.d.ts",
      "import": "./dist/curves/index.js",
      "require": "./dist/curves/index.cjs"
    },
    "./polygon": {
      "types": "./dist/polygon/index.d.ts",
      "import": "./dist/polygon/index.js",
      "require": "./dist/polygon/index.cjs"
    },
    "./culling": {
      "types": "./dist/culling/index.d.ts",
      "import": "./dist/culling/index.js",
      "require": "./dist/culling/index.cjs"
    },
    "./spatial-index": {
      "types": "./dist/spatial-index/index.d.ts",
      "import": "./dist/spatial-index/index.js",
      "require": "./dist/spatial-index/index.cjs"
    },
    "./utils/interpolate-packed-attributes": {
      "types": "./dist/utils/interpolate-packed-attributes.d.ts",
      "import": "./dist/utils/interpolate-packed-attributes.js",
      "require": "./dist/utils/interpolate-packed-attributes.cjs"
    },
    "./culling/oriented-box-2d": {
      "types": "./dist/culling/oriented-box-2d.d.ts",
      "import": "./dist/culling/oriented-box-2d.js",
      "require": "./dist/culling/oriented-box-2d.cjs"
    },
    "./culling/queries": {
      "types": "./dist/culling/queries.d.ts",
      "import": "./dist/culling/queries.js",
      "require": "./dist/culling/queries.cjs"
    },
    "./spatial-index/boxes": {
      "types": "./dist/spatial-index/box-index.d.ts",
      "import": "./dist/spatial-index/box-index.js",
      "require": "./dist/spatial-index/box-index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE"
  ],
  "dependencies": {
    "@math.gl/core": "5.0.0-alpha.19"
  },
  "sideEffects": false
}
