{
  "name": "@math.gl/geometry",
  "description": "CPU geometry primitives and tessellation for math.gl",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.18",
  "keywords": [
    "geometry",
    "gltf",
    "math",
    "mesh",
    "tessellation",
    "3d"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./parametric": {
      "types": "./dist/parametric.d.ts",
      "import": "./dist/parametric.js",
      "require": "./dist/parametric.cjs"
    },
    "./utils": {
      "types": "./dist/utils.d.ts",
      "import": "./dist/utils.js",
      "require": "./dist/utils.cjs"
    },
    "./curves": {
      "types": "./dist/curves.d.ts",
      "import": "./dist/curves.js",
      "require": "./dist/curves.cjs"
    },
    "./polygon": {
      "types": "./dist/polygon.d.ts",
      "import": "./dist/polygon.js",
      "require": "./dist/polygon.cjs"
    },
    "./culling": {
      "types": "./dist/culling.d.ts",
      "import": "./dist/culling.js",
      "require": "./dist/culling.cjs"
    },
    "./spatial-index": {
      "types": "./dist/spatial-index.d.ts",
      "import": "./dist/spatial-index.js",
      "require": "./dist/spatial-index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@math.gl/culling": "5.0.0-alpha.18",
    "@math.gl/curves": "5.0.0-alpha.18",
    "@math.gl/geometry-utils": "5.0.0-alpha.18",
    "@math.gl/polygon": "5.0.0-alpha.18",
    "@math.gl/spatial-index": "5.0.0-alpha.18",
    "@math.gl/types": "5.0.0-alpha.18"
  }
}
