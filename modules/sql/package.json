{
  "name": "@math.gl/sql",
  "version": "5.0.0-beta.11",
  "description": "Lightweight SQL query engine for Apache Arrow tables",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "files": [
    "dist",
    "src",
    "!src/**/README.md",
    "README.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./scales": {
      "types": "./dist/scales/index.d.ts",
      "import": "./dist/scales/index.js",
      "require": "./dist/scales/index.cjs"
    },
    "./scales/conformance": {
      "types": "./dist/scales/conformance.d.ts",
      "import": "./dist/scales/conformance.js",
      "require": "./dist/scales/conformance.cjs"
    },
    "./arrow-scales": {
      "types": "./dist/scales/arrow-scales.d.ts",
      "import": "./dist/scales/arrow-scales.js",
      "require": "./dist/scales/arrow-scales.cjs"
    },
    "./parser": {
      "types": "./dist/sql/index.d.ts",
      "import": "./dist/sql/index.js",
      "require": "./dist/sql/index.cjs"
    },
    "./expressions": {
      "types": "./dist/expressions/index.d.ts",
      "import": "./dist/expressions/index.js",
      "require": "./dist/expressions/index.cjs"
    },
    "./arrow": {
      "types": "./dist/arrow/index.d.ts",
      "import": "./dist/arrow/index.js",
      "require": "./dist/arrow/index.cjs"
    },
    "./worker": {
      "types": "./dist/arrow/worker.d.ts",
      "import": "./dist/arrow/worker.js",
      "require": "./dist/arrow/worker.cjs"
    },
    "./worker-entry.js": "./dist/arrow/worker-entry.js",
    "./query-worker-entry.js": "./dist/arrow/query-worker-entry.js",
    "./math-functions": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js",
      "require": "./dist/math/index.cjs"
    },
    "./color-functions": {
      "types": "./dist/color/index.d.ts",
      "import": "./dist/color/index.js",
      "require": "./dist/color/index.cjs"
    },
    "./raster": {
      "types": "./dist/raster/index.d.ts",
      "import": "./dist/raster/index.js",
      "require": "./dist/raster/index.cjs"
    },
    "./arrow-raster": {
      "types": "./dist/raster/arrow-raster.d.ts",
      "import": "./dist/raster/arrow-raster.js",
      "require": "./dist/raster/arrow-raster.cjs"
    }
  },
  "sideEffects": [
    "./dist/arrow/worker-entry.js",
    "./src/arrow/worker-entry.ts",
    "./dist/arrow/query-worker-entry.js",
    "./src/arrow/query-worker-entry.ts"
  ],
  "dependencies": {
    "@math.gl/arrow": "5.0.0-beta.11",
    "@math.gl/core": "5.0.0-beta.11",
    "@math.gl/geometry": "5.0.0-beta.11",
    "@math.gl/tasks": "5.0.0-beta.11"
  },
  "peerDependencies": {
    "apache-arrow": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "apache-arrow": {
      "optional": true
    }
  }
}
