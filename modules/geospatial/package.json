{
  "name": "@math.gl/geospatial",
  "description": "Geospatial classes",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.12",
  "keywords": [
    "webgl",
    "javascript",
    "math",
    "geospatial",
    "WGS84",
    "ellipsoid",
    "cartographic",
    "cartesian",
    "projection",
    "web mercator",
    "geographic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./turf": {
      "types": "./dist/turf.d.ts",
      "import": "./dist/turf.js",
      "require": "./dist/turf.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@math.gl/core": "5.0.0-alpha.12",
    "@math.gl/culling": "5.0.0-alpha.12",
    "@math.gl/geoarrow": "5.0.0-alpha.12",
    "@math.gl/types": "5.0.0-alpha.12"
  },
  "gitHead": "e1a95300cb225a90da6e90333d4adf290f7ba501",
  "devDependencies": {
    "@turf/area": "^7.2.0",
    "@turf/bearing": "^7.2.0",
    "@turf/boolean-point-in-polygon": "^7.2.0",
    "@turf/centroid": "^7.2.0",
    "@turf/distance": "^7.2.0"
  }
}
