{
  "name": "@math.gl/geospatial",
  "description": "Geospatial classes",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.18",
  "keywords": [
    "webgl",
    "javascript",
    "math",
    "geospatial",
    "WGS84",
    "ellipsoid",
    "cartographic",
    "cartesian",
    "projection",
    "web mercator",
    "geographic"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tile-matrix": {
      "types": "./dist/tile-matrix.d.ts",
      "import": "./dist/tile-matrix.js",
      "require": "./dist/tile-matrix.cjs"
    },
    "./crs": {
      "types": "./dist/crs.d.ts",
      "import": "./dist/crs.js",
      "require": "./dist/crs.cjs"
    },
    "./projection": {
      "types": "./dist/projection.d.ts",
      "import": "./dist/projection.js",
      "require": "./dist/projection.cjs"
    },
    "./web-mercator": {
      "types": "./dist/web-mercator.d.ts",
      "import": "./dist/web-mercator.js",
      "require": "./dist/web-mercator.cjs"
    },
    "./wkb": {
      "types": "./dist/wkb.d.ts",
      "import": "./dist/wkb.js",
      "require": "./dist/wkb.cjs"
    },
    "./geoarrow": {
      "types": "./dist/geoarrow.d.ts",
      "import": "./dist/geoarrow.js",
      "require": "./dist/geoarrow.cjs"
    },
    "./expressions": {
      "types": "./dist/expressions.d.ts",
      "import": "./dist/expressions.js",
      "require": "./dist/expressions.cjs"
    },
    "./ellipsoid": {
      "types": "./dist/entries/ellipsoid.d.ts",
      "import": "./dist/entries/ellipsoid.js",
      "require": "./dist/entries/ellipsoid.cjs"
    },
    "./globe": {
      "types": "./dist/globe.d.ts",
      "import": "./dist/globe.js",
      "require": "./dist/globe.cjs"
    },
    "./tiles": {
      "types": "./dist/tiles.d.ts",
      "import": "./dist/tiles.js",
      "require": "./dist/tiles.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@math.gl/core": "5.0.0-alpha.18",
    "@math.gl/crs": "5.0.0-alpha.18",
    "@math.gl/culling": "5.0.0-alpha.18",
    "@math.gl/geoarrow": "5.0.0-alpha.18",
    "@math.gl/polygon": "5.0.0-alpha.18",
    "@math.gl/projection": "5.0.0-alpha.18",
    "@math.gl/types": "5.0.0-alpha.18",
    "@math.gl/web-mercator": "5.0.0-alpha.18",
    "@math.gl/wkb": "5.0.0-alpha.18"
  },
  "gitHead": "e1a95300cb225a90da6e90333d4adf290f7ba501"
}
