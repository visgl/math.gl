{
  "name": "@math.gl/proj4",
  "description": "Proj4js wrapper for conversion between geospatial CRS (coordinate reference systems)",
  "license": "MIT AND Apache-2.0",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.9",
  "keywords": [
    "webgl",
    "javascript",
    "math",
    "geospatial",
    "WGS84",
    "ellipsoid",
    "cartographic",
    "cartesian",
    "projection",
    "web mercator",
    "geographic",
    "proj4",
    "proj4js"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./experimental": {
      "types": "./dist/experimental/index.d.ts",
      "import": "./dist/experimental/index.js",
      "require": "./dist/experimental/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "PROJ4-LICENSE.md",
    "APACHE-2.0-LICENSE.txt",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "@math.gl/core": "5.0.0-alpha.9",
    "@math.gl/crs": "5.0.0-alpha.9",
    "proj4": "2.22.0"
  },
  "gitHead": "e1a95300cb225a90da6e90333d4adf290f7ba501",
  "sideEffects": false
}
