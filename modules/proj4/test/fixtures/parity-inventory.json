  "gaps": [
    {
      "id": "crs-normalization",
      "tranche": 7,
      "reason": "The 2026-09-29 full upstream corpus audit finds 11 silent structured-CRS mismatches (polar WKT and datum name/EPSG lookup), five pole-origin roundoff rejections, and unsupported method/parameter/axis mappings. See docs/modules/proj4/parity-audit.md and test/fixtures/parity-audit-2026-09-29.json. Composite/perspective and Hotine/Krovak structured variants, derived CRSs and axis-meridian operations remain incomplete."
    },
    {
      "id": "projection-parameters",
      "tranche": 7,
      "reason": "All upstream algorithm modules now have native coverage; exhaustive parameter combinations, inverse domain boundaries, and uncommon structured variants still need an independent corpus before promotion."
    },
    {
      "id": "native-proj-corpus",
      "tranche": 7,
      "reason": "Independent checks currently use published PROJ UTM examples. Expand into a reproducibly generated native PROJ/EPSG corpus; the local PROJ executable is incompatible with this host."
    },
    {
      "id": "grid-reference-corpus",
      "tranche": 7,
      "reason": "Synthetic fixtures pass. The 2026-09-29 external real-grid audit passes 24/26 upstream cases; two GeoTIFF western-edge cases are rejected by the native strict-coverage policy and need explicit disposition. Add maintained licensed real-world fixtures and independent reference outputs before promotion; broader metadata/band conventions and vertical grids remain outside the horizontal subset."
    }
  ],
  "exceptions": [
    {
      "id": "equatorial-stereographic-y0",
      "description": "Native stere includes false northing in the ellipsoidal equatorial forward branch; upstream 2.22.0 omits it. Other branches retain parity.",
      "test": "test/lib/common-projections.spec.ts"
    },
    {
      "id": "explicit-errors",
      "description": "Invalid definitions, singular antipodes, nonconvergence and non-finite kernel results throw instead of upstream null/undefined/NaN/sentinel results.",
      "test": "test/lib/common-projections.spec.ts"
    },
    {
      "id": "initialized-defaults",
      "description": "Native projection parameters always initialize origin and false offsets to zero. Some upstream kernels return NaN when these parameters are omitted; differential cases supply them explicitly.",
      "test": "test/lib/common-projections.spec.ts"
    },
    {
      "id": "strict-utm-zone",
      "description": "Native UTM requires integer zone 1..60 and value-free south/approx flags. Inferred zones, negative zones and permissive flag values are outside the supported subset.",
      "test": "test/lib/common-projections.spec.ts"
    },
    {
      "id": "spherical-tmerc-latitude-sign",
      "description": "Native +approx spherical TM uses the absolute latitude sign in its inverse. Upstream uses northing relative to lat_0, which flips some latitudes when lat_0 is nonzero.",
      "test": "test/lib/common-projections.spec.ts"
    },
    {
      "id": "conic-opposite-pole",
      "description": "Native LCC rejects its opposite pole instead of upstream latitude clamping that returns a huge finite value.",
      "test": "test/lib/common-projections.spec.ts"
    },
    {
      "id": "computed-heights",
      "description": "Native arrays expose transformed height; proj4js normally restores input Z unless axes are enforced. Geocentric output always has three components and scales X/Y/Z consistently.",
      "test": "test/lib/crs-datums.spec.ts"
    },
    {
      "id": "strict-crs-boundaries",
      "description": "Unknown/absent CRS metadata, dynamic datums and unsupported structured operations fail explicitly. Compound extraction is opt-in and reports lossy; horizontal grid registrations are now handled by tranche 6.",
      "test": "test/lib/crs-datums.spec.ts"
    },
    {
      "id": "angular-formats",
      "description": "Native DMS/radian PROJ angles normalize to decimal degrees; proj4js 2.22.0 does not interpret these forms. Explicit to_meter overrides named units independent of token order.",
      "test": "test/lib/crs-datums.spec.ts"
    },
    {
      "id": "explicit-datum-none",
      "description": "Native datum=none explicitly disables supplied Helmert parameters; malformed or conflicting declarations remain subject to validation.",
      "test": "test/lib/crs-datums.spec.ts"
    },
    {
      "id": "equatorial-conic-parallel",
      "description": "Native LCC and EQDC preserve explicit lat_2=0; upstream truthiness defaults replace it with lat_1. Regression comparisons use the equivalent swapped-parallel definition.",
      "test": "test/lib/common-projections.spec.ts"
    },
    {
      "id": "explicit-flattening-and-wgs72",
      "description": "Explicit f=0/rf=0 selects a sphere unless b overrides it, including named ellipsoids with a stored semi-minor axis. WGS72 corrects the upstream WGS7 lookup typo.",
      "test": "test/lib/crs-datums.spec.ts"
    },
    {
      "id": "catalogue-offsets",
      "description": "Native catalogue adapters apply false easting/northing consistently in both directions, including upstream sinu/eck6/geos/tpers branches that omit them. Differential tests compare zero-offset upstream results plus the declared offsets.",
      "test": "test/lib/catalogue-projections.spec.ts"
    },
    {
      "id": "catalogue-inverse-origins",
      "description": "Native equi returns the inverse point; gnom and tpers return their configured geographic origin at zero radius; vandg handles its equator analytically instead of a singular cubic.",
      "test": "test/lib/catalogue-projections.spec.ts"
    },
    {
      "id": "southern-bonne",
      "description": "Native Bonne inverse preserves the signed radius for a negative standard parallel; forward comparisons retain upstream parity.",
      "test": "test/lib/catalogue-projections.spec.ts"
    },
    {
      "id": "mollweide-poles",
      "description": "Native Mollweide uses an analytical pole limit and bounded iteration, retaining the southern sign during inverse clamping.",
      "test": "test/lib/catalogue-projections.spec.ts"
    },
    {
      "id": "perspective-domains",
      "description": "Native perspective plugins reject invisible points; orthographic inverse rejects coordinates outside its disk. Upstream may return approximations, NaN or a clamped finite inverse.",
      "test": "test/lib/catalogue-projections.spec.ts"
    },
    {
      "id": "explicit-oblique-dependency",
      "description": "ob_tran requires an explicitly supplied wrapped plugin or longlat; o_proj must agree with it. It cannot wrap geocentric or another ob_tran plugin.",
      "test": "test/lib/catalogue-projections.spec.ts"
    },
    {
      "id": "mollweide-unwrapped-longitude",
      "description": "Native Mollweide inverse retains longitudes outside ±180 degrees when +over is enabled. Upstream 2.22.0 clamps after its over-aware longitude adjustment; the native inverse clamps only when wrapping is enabled.",
      "test": "test/lib/catalogue-projections.spec.ts"
    },
    {
      "id": "grid-edges-and-inverse",
      "description": "Native bilinear interpolation includes final rows/columns, and inverse shifts require both ordinates to converge within 20 iterations. Shifted boundary coordinates are solved within a displacement envelope and must return to the true source extent; no approximate edge inverse is accepted.",
      "test": "test/lib/datum-grids.spec.ts"
    },
    {
      "id": "grid-nodata",
      "description": "Non-finite shift nodes and GeoTIFF GDAL nodata are treated as unavailable cells, with fallback to later subgrids/grids. Zero-weight invalid neighbors do not invalidate an exact usable node.",
      "test": "test/lib/datum-grids.spec.ts"
    },
    {
      "id": "grid-destination",
      "description": "Native destination grid shifts run even when the effective source/destination ellipsoids are both WGS84; upstream datum_transform can return early before the destination inverse grid stage.",
      "test": "test/lib/datum-grids.spec.ts"
    },
    {
      "id": "grid-registration",
      "description": "Prepared grids are registered through each instance's datumGrids map and captured at construction. All required entries preceding a null fallback must be loaded; unavailable optional grids are skipped, and exhausted coverage throws. No global registry or implicit network loading.",
      "test": "test/lib/datum-grids.spec.ts"
    },
    {
      "id": "typed-array-batches",
      "description": "Native-only Float32Array/Float64Array in-place APIs use complete interleaved records, require space for geocentric Z, preserve trailing ordinates and commit earlier records before an error. Built-in mutable hooks avoid temporary coordinate arrays; legacy custom plugins retain scalar fallback.",
      "test": "test/lib/batch-projection.spec.ts"
    }
  ]
}
