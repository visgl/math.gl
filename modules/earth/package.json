{
  "name": "@math.gl/earth",
  "description": "Earth and astronomy utilities for math.gl",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-beta.5",
  "keywords": [
    "earth",
    "geoid",
    "sun",
    "timezone",
    "geospatial"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./sun": {
      "types": "./dist/sun/index.d.ts",
      "import": "./dist/sun/index.js",
      "require": "./dist/sun/index.cjs"
    },
    "./timezone": {
      "types": "./dist/timezone/index.d.ts",
      "import": "./dist/timezone/index.js",
      "require": "./dist/timezone/index.cjs"
    },
    "./geoid/geoid-egm96-low.pgm": "./data/geoid/geoid-egm96-low.pgm",
    "./geoid/geoid-egm96-hi.pgm": "./data/geoid/geoid-egm96-hi.pgm",
    "./timezone/timezone-geometry-low.json": "./data/timezone/timezone-geometry-low.json",
    "./timezone/timezone-geometry-low.parquet": "./data/timezone/timezone-geometry-low.parquet",
    "./timezone/timezone-geometry-hi.json": "./data/timezone/timezone-geometry-hi.json",
    "./timezone/timezone-geometry-hi.parquet": "./data/timezone/timezone-geometry-hi.parquet",
    "./sun/stars": {
      "types": "./dist/sun/stars.d.ts",
      "import": "./dist/sun/stars.js",
      "require": "./dist/sun/stars.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/README.md",
    "./README.md",
    "data",
    "LICENSE-HOSEK-WILKIE",
    "LICENSE-SUNCALC",
    "LICENSE-BRIGHT-STARS",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": false,
  "dependencies": {
    "@math.gl/core": "5.0.0-beta.5",
    "astronomy-engine": "2.1.19"
  }
}
