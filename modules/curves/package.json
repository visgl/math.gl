{
  "name": "@math.gl/curves",
  "description": "Renderer-independent 2D and 3D parametric curves and arc-length sampling",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.12",
  "keywords": [
    "math",
    "curve",
    "bezier",
    "spline",
    "interpolation"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "dependencies": {
    "@math.gl/types": "5.0.0-alpha.12"
  },
  "sideEffects": false
}
