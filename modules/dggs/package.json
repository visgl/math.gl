{
  "name": "@math.gl/dggs",
  "description": "Lightweight cell geometry decoders for DGGS and DGGS-like systems",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-beta.2",
  "keywords": [
    "javascript",
    "math",
    "geospatial",
    "dggs",
    "a5",
    "h3",
    "s2",
    "geohash",
    "quadkey",
    "plus-codes"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md"
  ],
  "dependencies": {
    "@math.gl/core": "5.0.0-beta.2",
    "a5-js": "^0.10.0",
    "h3-js": "^4.5.0",
    "open-location-code": "^1.0.3"
  },
  "devDependencies": {
    "s2-geometry": "^1.2.10"
  },
  "sideEffects": false
}
