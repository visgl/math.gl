{
  "name": "@math.gl/timezone",
  "description": "Geographic timezone lookup and local calendar computations complementary to Intl",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.13",
  "keywords": [
    "timezone",
    "geospatial",
    "latitude",
    "longitude"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./lookup": {
      "types": "./dist/lookup.d.ts",
      "import": "./dist/lookup.js",
      "require": "./dist/lookup.cjs"
    },
    "./temporal": {
      "types": "./dist/temporal.d.ts",
      "import": "./dist/temporal.js",
      "require": "./dist/temporal.cjs"
    },
    "./timezone-geometry-low.json": "./data/timezone-geometry-low.json",
    "./timezone-geometry-low.parquet": "./data/timezone-geometry-low.parquet",
    "./timezone-geometry-hi.json": "./data/timezone-geometry-hi.json",
    "./timezone-geometry-hi.parquet": "./data/timezone-geometry-hi.parquet"
  },
  "files": [
    "dist",
    "src",
    "data"
  ],
  "sideEffects": false,
  "dependencies": {
    "@js-temporal/polyfill": "^0.5.1",
    "@photostructure/tz-lookup": "^11.7.0"
  }
}
