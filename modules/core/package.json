{
  "name": "@math.gl/core",
  "description": "Array-based 3D Math Classes optimized for WebGL applications",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.5",
  "keywords": [
    "webgl",
    "javascript",
    "math",
    "matrix",
    "matrix4",
    "vector",
    "vector2",
    "vector3",
    "vector4",
    "quaternion",
    "euler",
    "spherical",
    "coordinates",
    "3d"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mat3": {
      "types": "./dist/mat3.d.ts",
      "import": "./dist/mat3.js",
      "require": "./dist/mat3.cjs"
    },
    "./mat4": {
      "types": "./dist/mat4.d.ts",
      "import": "./dist/mat4.js",
      "require": "./dist/mat4.cjs"
    },
    "./quat": {
      "types": "./dist/quat.d.ts",
      "import": "./dist/quat.js",
      "require": "./dist/quat.cjs"
    },
    "./vec2": {
      "types": "./dist/vec2.d.ts",
      "import": "./dist/vec2.js",
      "require": "./dist/vec2.cjs"
    },
    "./vec3": {
      "types": "./dist/vec3.d.ts",
      "import": "./dist/vec3.js",
      "require": "./dist/vec3.cjs"
    },
    "./vec4": {
      "types": "./dist/vec4.d.ts",
      "import": "./dist/vec4.js",
      "require": "./dist/vec4.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./src/lib/common.js"
  ],
  "dependencies": {
    "@math.gl/types": "5.0.0-alpha.5"
  },
  "gitHead": "e1a95300cb225a90da6e90333d4adf290f7ba501"
}
