{
  "name": "@math.gl/core",
  "description": "Foundational matrix, color, UTF-8, and optional Arrow utilities",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.3",
  "keywords": [
    "webgl",
    "javascript",
    "math",
    "matrix",
    "matrix4",
    "vector",
    "vector2",
    "vector3",
    "vector4",
    "quaternion",
    "euler",
    "spherical",
    "coordinates",
    "3d"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "exports": {
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "require": "./dist/types.cjs"
    },
    "./matrix": {
      "types": "./dist/matrix.d.ts",
      "import": "./dist/matrix.js",
      "require": "./dist/matrix.cjs"
    },
    "./color": {
      "types": "./dist/color/index.d.ts",
      "import": "./dist/color/index.js",
      "require": "./dist/color/index.cjs"
    },
    "./utf8": {
      "types": "./dist/utf8.d.ts",
      "import": "./dist/utf8.js",
      "require": "./dist/utf8.cjs"
    },
    "./arrow": {
      "types": "./dist/arrow.d.ts",
      "import": "./dist/arrow.js",
      "require": "./dist/arrow.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/README.md",
    "./README.md",
    "PROJ4-LICENSE.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "ARROW-NOTICE.txt",
    "APACHE-2.0-LICENSE.txt",
    "arrow-LICENSE",
    "arrow-THIRD-PARTY-NOTICES.md"
  ],
  "sideEffects": [
    "./src/lib/common.js"
  ],
  "peerDependencies": {
    "apache-arrow": ">=17.0.0"
  },
  "peerDependenciesMeta": {
    "apache-arrow": {
      "optional": true
    }
  },
  "dependencies": {
    "@math.gl/tasks": "5.0.3"
  }
}
