{
  "name": "@math.gl/core",
  "description": "Array-based 3D Math Classes optimized for WebGL applications",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "version": "5.0.0-alpha.20",
  "keywords": [
    "webgl",
    "javascript",
    "math",
    "matrix",
    "matrix4",
    "vector",
    "vector2",
    "vector3",
    "vector4",
    "quaternion",
    "euler",
    "spherical",
    "coordinates",
    "3d"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/math.gl.git"
  },
  "types": "dist/index.d.ts",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./worker-utils": {
      "types": "./dist/worker-utils/index.d.ts",
      "import": "./dist/worker-utils/index.js",
      "require": "./dist/worker-utils/index.cjs"
    },
    "./task-runtime": {
      "types": "./dist/task-runtime/index.d.ts",
      "import": "./dist/task-runtime/index.js",
      "require": "./dist/task-runtime/index.cjs"
    }
  },
  "files": [
    "dist",
    "src",
    "PROJ4-LICENSE.md",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "ARROW-NOTICE.txt",
    "APACHE-2.0-LICENSE.txt",
    "LOADERS-GL-LICENSE.txt"
  ],
  "sideEffects": [
    "./src/lib/common.js"
  ],
  "browser": {
    "./dist/worker-utils/lib/node/worker_threads.js": "./dist/worker-utils/lib/node/worker_threads-browser.js",
    "./src/worker-utils/lib/node/worker_threads.ts": "./src/worker-utils/lib/node/worker_threads-browser.ts",
    "./dist/worker-utils/lib/process-utils/child-process-proxy.js": "./dist/worker-utils/lib/process-utils/child-process-proxy.browser.js",
    "./src/worker-utils/lib/process-utils/child-process-proxy.ts": "./src/worker-utils/lib/process-utils/child-process-proxy.browser.ts",
    "child_process": false,
    "fs": false,
    "module": false,
    "path": false
  }
}
