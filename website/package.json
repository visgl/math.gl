    "probe.gl": "5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remark-parse": "^11.0.0",
    "s2-geometry": "^1.2.10",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@docusaurus/utils": "^3.10.2",
    "@types/d3-geo": "2",
    "@types/react": "^19.2.18",
    "proj4": "2.22.0",
    "webpack": "^5.109.2"
  },
  "browserslist": [
    ">0.2% and supports async-functions",
    "not dead"
