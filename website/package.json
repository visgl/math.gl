{
  "name": "project-website",
  "version": "0.0.0",
  "private": true,
  "description": "Website for vis.gl project",
  "scripts": {
    "start": "docusaurus start",
    "build": "node ../scripts/citations/check.mjs && node scripts/prepare-projection-lab.mjs && docusaurus build && node scripts/normalize-llm-output.mjs && node scripts/check-llm-output.mjs && node ../scripts/citations/check-rendered.mjs",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-heading-ids": "ocular-doc-headers ../docs",
    "deploy": "docusaurus deploy",
    "screenshots": "node scripts/update-example-screenshots.mjs"
  },
  "dependencies": {
    "@deck.gl-community/geo-layers": "10.0.0-alpha.1",
    "@deck.gl-community/panels": "10.0.0-alpha.1",
    "@deck.gl/core": "10.0.0-alpha.1",
    "@deck.gl/extensions": "10.0.0-alpha.1",
    "@deck.gl/geo-layers": "10.0.0-alpha.1",
    "@deck.gl/layers": "10.0.0-alpha.1",
    "@deck.gl/mesh-layers": "10.0.0-alpha.1",
    "@deck.gl/react": "10.0.0-alpha.1",
    "@deck.gl/widgets": "10.0.0-alpha.1",
    "@docusaurus/core": "^3.10.2",
    "@fontsource-variable/source-sans-3": "^5.2.7",
    "@fontsource-variable/space-grotesk": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@loaders.gl/core": "5.0.0-beta.8",
    "@luma.gl/core": "10.0.0-alpha.14",
    "@luma.gl/engine": "10.0.0-alpha.14",
    "@luma.gl/shaders": "10.0.0-alpha.14",
    "@math.gl/arrow": "workspace:*",
    "@math.gl/core": "workspace:*",
    "@math.gl/dggs": "workspace:*",
    "@math.gl/earth": "workspace:*",
    "@math.gl/expressions": "5.0.0-beta.9",
    "@math.gl/geometry": "workspace:*",
    "@math.gl/geospatial": "workspace:*",
    "@math.gl/tasks": "workspace:*",
    "@math.gl/web-mercator": "workspace:*",
    "@mdx-js/react": "^3.1.1",
    "@signalwire/docusaurus-plugin-llms-txt": "^1.2.2",
    "@vis.gl/docusaurus-website": "2.0.0-alpha.6",
    "a5-js": "^0.10.0",
    "d3-geo": "^2.0.2",
    "h3-js": "^4.5.0",
    "math.gl-parquet-loader": "workspace:*",
